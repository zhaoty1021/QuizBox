.page {
  min-height: 100vh;
  background-color: #0d0d1a;
}

/* ========== 氛围顶部 ========== */
.hero {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  top: -100rpx;
  left: 50%;
  margin-left: -200rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(233,69,96,0.25) 0%, rgba(83,52,131,0.1) 50%, transparent 70%);
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  position: relative;
  z-index: 1;
}

.hero-sub {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

/* ========== 分类 Tab ========== */
.tab-bar {
  white-space: nowrap;
  padding: 0 30rpx 24rpx;
}

.tab-item {
  display: inline-block;
  padding: 14rpx 32rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #aaaaaa;
  background-color: rgba(255,255,255,0.06);
  border-radius: 50rpx;
  border: 2rpx solid transparent;
}

.tab-item.active {
  color: #ffffff;
  background-color: rgba(233,69,96,0.2);
  border-color: #e94560;
}

/* ========== 测试卡片列表 ========== */
.test-list {
  padding: 0 30rpx 120rpx;
}

.test-card {
  background-color: #16213e;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
}

.test-card-hover {
  background-color: #1a2a50;
}

/* 卡片封面区 */
.card-cover-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.test-cover {
  width: 100%;
  height: 100%;
  background-color: #1a2a50;
}

.card-cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(to top, #16213e 0%, transparent 100%);
}

.test-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  font-size: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 50rpx;
  color: #ffffff;
}

.tag-destiny {
  background-color: rgba(233,69,96,0.85);
}

.tag-psychology {
  background-color: rgba(83,52,131,0.85);
}

.tag-life {
  background-color: rgba(15,138,138,0.85);
}

.tag-comedy {
  background-color: rgba(232,168,56,0.85);
}

.tag-relationship {
  background-color: rgba(224,82,151,0.85);
}

.tag-brainhole {
  background-color: rgba(34,197,94,0.85);
}

/* 卡片信息区 */
.card-body {
  padding: 20rpx 24rpx 24rpx;
}

.test-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.test-count {
  font-size: 22rpx;
  color: #666666;
}

.card-arrow {
  font-size: 24rpx;
  color: #e94560;
  font-weight: bold;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
}

/* ========== Banner 广告 ========== */
.banner-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #0d0d1a;
  padding: 8rpx 0;
}
